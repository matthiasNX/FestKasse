<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:FestKasse.Converters"
             x:Class="FestKasse.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <converters:ChangeColorConverter x:Key="ChangeColorConverter"/>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:GreaterThanZeroConverter x:Key="GreaterThanZeroConverter"/>
            <converters:NewEditTitleConverter x:Key="NewEditTitleConverter"/>
            <converters:SelectedColorBorderConverter x:Key="SelectedColorBorderConverter"/>
            <converters:SyncButtonTextConverter x:Key="SyncButtonTextConverter"/>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <converters:DecimalInputConverter x:Key="DecimalInputConverter"/>
            <converters:TabActiveConverter x:Key="TabActiveConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
