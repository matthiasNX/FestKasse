# Copy this file to .env and fill in your value.
# .env is git-ignored and must never be committed.
#
# Set this environment variable before doing a release build:
#   $env:FESTKASSE_KEYSTORE_PASS = "your_password_here"   (PowerShell)
#   export FESTKASSE_KEYSTORE_PASS=your_password_here      (bash/macOS/Linux)

FESTKASSE_KEYSTORE_PASS=your_keystore_password_here
