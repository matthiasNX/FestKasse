<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FestKasse.ViewModels"
             xmlns:models="clr-namespace:FestKasse.Models"
             x:Class="FestKasse.Controls.OrderHistoryItemView"
             x:DataType="viewmodels:OrderHistoryItem">

    <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 10" Margin="0,3">
        <VerticalStackLayout>

            <!-- Header row (tap to expand) -->
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Padding="12,8" ColumnSpacing="8">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleExpandCommand}"/>
                </Grid.GestureRecognizers>
                <Label Grid.Column="0" Text="&#x1F4C5;" FontSize="16" VerticalOptions="Center"/>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                    <Label Text="{Binding TimestampDisplay}" FontSize="14" FontAttributes="Bold"
                           TextColor="{StaticResource Gray900}"/>
                    <Label Text="{Binding StandName}" FontSize="11" TextColor="{StaticResource Gray500}"/>
                </VerticalStackLayout>
                <Label Grid.Column="2" Text="{Binding TotalDisplay}" FontSize="16" FontAttributes="Bold"
                       TextColor="{StaticResource Primary}" VerticalOptions="Center"/>
                <Label Grid.Column="3" Text="&#x25BC;" FontSize="12"
                       TextColor="{StaticResource Gray400}" VerticalOptions="Center" Margin="6,0,0,0"/>
                <Button Grid.Column="4" Text="&#x1F5D1;" FontSize="16"
                        WidthRequest="38" HeightRequest="38" Padding="0"
                        BackgroundColor="Transparent" TextColor="#CC2200"
                        Command="{Binding DeleteCommand}"
                        VerticalOptions="Center"/>
            </Grid>

            <!-- Expanded line items -->
            <VerticalStackLayout IsVisible="{Binding IsExpanded}"
                                 BackgroundColor="{StaticResource Gray100}"
                                 Padding="6,3" Spacing="0"
                                 BindableLayout.ItemsSource="{Binding Items}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:OrderItemRecord">
                        <Grid ColumnDefinitions="Auto,*,Auto" Padding="8,3">
                            <Label Grid.Column="0" Text="{Binding Quantity, StringFormat='{0}x'}"
                                   FontSize="13" WidthRequest="30" TextColor="{StaticResource Gray700}"
                                   FontAttributes="Bold"/>
                            <Label Grid.Column="1" Text="{Binding ArticleName}" FontSize="13"
                                   TextColor="{StaticResource Gray700}"/>
                            <Label Grid.Column="2" Text="{Binding LineTotal, StringFormat='{0:F2} €'}"
                                   FontSize="13" FontAttributes="Bold" HorizontalOptions="End"
                                   TextColor="{StaticResource Gray900}"/>
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </Border>

</ContentView>
