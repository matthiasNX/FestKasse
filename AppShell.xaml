<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="FestKasse.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:FestKasse.Views"
    xmlns:helpers="clr-namespace:FestKasse.Helpers"
    FlyoutBehavior="Flyout"
    >

    <!-- Flyout header -->
    <Shell.FlyoutHeader>
        <Grid BackgroundColor="{StaticResource Primary}" Padding="10">
            <Label Text="&#x1F4B0; FestKasse" FontSize="22" FontAttributes="Bold" TextColor="White"/>
        </Grid>
    </Shell.FlyoutHeader>

    <Shell.MenuItemTemplate>
        <DataTemplate>
            <Grid HeightRequest="44">
                <Label Text="{Binding Text}"
                       VerticalOptions="Center"
                       HorizontalOptions="Start"
                       Margin="16,0,0,0"/>
            </Grid>
        </DataTemplate>
    </Shell.MenuItemTemplate>

    <Shell.FlyoutFooter>
        <Grid BackgroundColor="{StaticResource Primary}" Padding="10">
            <Label Text="FestKasse – Kassieren statt kassieren müssen." FontSize="15" FontAttributes="Bold" TextColor="White"/>
        </Grid>
    </Shell.FlyoutFooter>

    <!-- Main page -->
    <FlyoutItem Title="Kasse" Route="MainPage" Shell.FlyoutItemIsVisible="False">
        <ShellContent ContentTemplate="{DataTemplate views:MainPage}" Route="MainPage"/>
    </FlyoutItem>

    <!-- Navigation menu items -->
    <MenuItem Text="{helpers:Tr Key=Menu_POS}"              Clicked="OnKasseClicked"/>
    <MenuItem Text="{helpers:Tr Key=Menu_StandManagement}"   Clicked="OnStandManagementClicked"/>
    <MenuItem Text="{helpers:Tr Key=Menu_CategoryManagement}" Clicked="OnCategoryManagementClicked"/>
    <MenuItem Text="{helpers:Tr Key=Menu_ArticleManagement}"  Clicked="OnArticleManagementClicked"/>
    <MenuItem Text="{helpers:Tr Key=Menu_Settings}"       Clicked="OnSettingsClicked"/>
    <MenuItem Text="{helpers:Tr Key=Menu_OrderHistory}"      Clicked="OnOrderHistoryClicked"/>
    <MenuItem Text="{helpers:Tr Key=Menu_Dashboard}"          Clicked="OnDashboardClicked"/>
    <MenuItem Text="{helpers:Tr Key=Menu_CashSession}"         Clicked="OnCashSessionClicked"/>
    <MenuItem Text="{helpers:Tr Key=Menu_LogViewer}"            Clicked="OnLogViewerClicked"/>
    <MenuItem Text="{helpers:Tr Key=Menu_About}"               Clicked="OnAboutClicked"/>

</Shell>
