<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
	<TargetFrameworks>net9.0-android;net9.0-windows10.0.19041.0</TargetFrameworks>
	<OutputType>Exe</OutputType>
	<RootNamespace>FestKasse</RootNamespace>
	<UseMaui>true</UseMaui>
	<SingleProject>true</SingleProject>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>

	<!-- Display name -->
	<ApplicationTitle>FestKasse</ApplicationTitle>

	<!-- App Identifier -->
	<ApplicationId>com.festkasse.app</ApplicationId>

	<!-- Versions -->
	<ApplicationDisplayVersion>1.1</ApplicationDisplayVersion>
	<ApplicationVersion>1</ApplicationVersion>

	<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
	<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</SupportedOSPlatformVersion>
	<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	<WindowsAppSDKSelfContained Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">true</WindowsAppSDKSelfContained>
  </PropertyGroup>

	<!-- Read signing password from keystore.properties — git-ignored, never committed -->
	<PropertyGroup Condition="Exists('keystore.properties')">
		<_KeystoreProps>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\keystore.properties'))</_KeystoreProps>
		<AndroidSigningStorePass>$([System.Text.RegularExpressions.Regex]::Match($(_KeystoreProps), 'KeystorePassword=(.+)').Groups[1].Value.Trim())</AndroidSigningStorePass>
		<AndroidSigningKeyPass>$(AndroidSigningStorePass)</AndroidSigningKeyPass>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<RunAOTCompilation>False</RunAOTCompilation>
		<PublishTrimmed>False</PublishTrimmed>
		<AndroidKeyStore>true</AndroidKeyStore>
		<AndroidSigningKeyStore>$(MSBuildProjectDirectory)\FestKasse.keystore</AndroidSigningKeyStore>
		<AndroidSigningKeyAlias>festkasse</AndroidSigningKeyAlias>
	</PropertyGroup>

  <ItemGroup>
	<!-- App Icon -->
	<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#2E7D32" />

	<!-- Splash Screen -->
	<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#2E7D32" BaseSize="128,128" />

	<!-- Images -->
	<MauiImage Include="Resources\Images\*" />
	<MauiImage Remove="Resources\Images\.gitkeep" />

	<!-- Custom Fonts -->
	<MauiFont Include="Resources\Fonts\*" />

	<!-- Raw Assets -->
	<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	<AndroidResource Include="Platforms\Android\Resources\xml\network_security_config.xml" />
	<MauiAsset Remove="Resources\Raw\.gitkeep" />
  </ItemGroup>

  <ItemGroup>
	<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
	<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.5" />
	<PackageReference Include="Microsoft.Maui.Controls" Version="9.0.60" />
	<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="9.0.60" />
	<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.0" />
	<PackageReference Include="Serilog" Version="4.2.0" />
	<PackageReference Include="Serilog.Extensions.Logging" Version="9.0.1" />
	<PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
	<PackageReference Include="ZXing.Net.Maui.Controls" Version="0.6.0" />
  </ItemGroup>

  <ItemGroup>
