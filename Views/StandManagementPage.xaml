<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FestKasse.ViewModels"
             xmlns:models="clr-namespace:FestKasse.Models"
             x:Class="FestKasse.Views.StandManagementPage"
             x:Name="StandPage"
             x:DataType="viewmodels:StandManagementViewModel"
             Title="Standverwaltung"
             BackgroundColor="{StaticResource Gray100}">

    <ScrollView>
        <VerticalStackLayout Spacing="15" Padding="15">

            <!-- Neuen Stand hinzufügen -->
            <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Neuen Stand anlegen" FontSize="18" FontAttributes="Bold"/>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Entry Grid.Column="0"
                               Text="{Binding NewStandName}"
                               Placeholder="Standname (z.B. Brotzeitstand)"
                               BackgroundColor="{StaticResource Gray100}"/>
                        <Button Grid.Column="1"
                                Text="&#x2795; Hinzufügen"
                                Command="{Binding AddStandCommand}"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="White"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Vorhandene Stände -->
            <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="5">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Vorhandene Stände" FontSize="18" FontAttributes="Bold"/>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Stands}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:Stand">
                                <Border StrokeShape="RoundRectangle 8" StrokeThickness="1"
                                        Stroke="{StaticResource Gray300}" Padding="6,10">
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                                        <Label Grid.Column="0" Text="{Binding Name}"
                                               FontSize="16" FontAttributes="Bold" VerticalOptions="Center"/>
                                        <Button Grid.Column="1" Text="&#x2714; Aktiv setzen"
                                                Command="{Binding Source={x:Reference StandPage}, Path=BindingContext.SelectStandCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="{StaticResource Primary}" TextColor="White"
                                                FontSize="13" Padding="10,0" HeightRequest="38"/>
                                        <Button Grid.Column="2" Text="&#x270E;"
                                                Command="{Binding Source={x:Reference StandPage}, Path=BindingContext.RenameStandCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="{StaticResource Gray300}" TextColor="{StaticResource Gray900}"
                                                FontSize="16" WidthRequest="40" HeightRequest="38" Padding="0"/>
                                        <Button Grid.Column="3" Text="&#x1F5D1;"
                                                Command="{Binding Source={x:Reference StandPage}, Path=BindingContext.DeleteStandCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#F44336" TextColor="White"
                                                FontSize="16" WidthRequest="40" HeightRequest="38" Padding="0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
