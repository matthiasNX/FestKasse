<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FestKasse.ViewModels"
             xmlns:models="clr-namespace:FestKasse.Models"
             xmlns:controls="clr-namespace:FestKasse.Controls"
             xmlns:converters="clr-namespace:FestKasse.Converters"
             x:Class="FestKasse.Views.ArticleManagementPage"
             x:Name="ThisPage"
             x:DataType="viewmodels:ArticleManagementViewModel"
             Title="Artikelverwaltung"
             BackgroundColor="{StaticResource Gray100}">

    <ContentPage.Resources>
        <converters:DecimalInputConverter x:Key="DecimalInputConverter"/>
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">

        <Grid Grid.Row="0">

            <!-- Article List -->
            <CollectionView ItemsSource="{Binding Articles}" SelectionMode="None" Margin="10">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Article">
                        <Border Margin="0,5" Padding="10" BackgroundColor="White" StrokeShape="RoundRectangle 8" StrokeThickness="0">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
                                <BoxView Grid.Column="0" Color="{Binding DisplayColor}" WidthRequest="8" HeightRequest="40" CornerRadius="4" Margin="0,0,10,0"/>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                    <Label Text="{Binding Description}" FontSize="16" FontAttributes="Bold"/>
                                    <HorizontalStackLayout Spacing="10">
                                        <Label Text="{Binding Category}" FontSize="12" TextColor="Gray"/>
                                        <Label Text="{Binding PriceDisplay}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Primary}"/>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                                <Button Grid.Column="2" Text="&#x25B2;" WidthRequest="40" HeightRequest="40" FontSize="12" Padding="0"
                                        BackgroundColor="{StaticResource Gray300}" TextColor="{StaticResource Gray900}"
                                        Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.MoveUpCommand}" CommandParameter="{Binding .}"/>
                                <Button Grid.Column="3" Text="&#x25BC;" WidthRequest="40" HeightRequest="40" FontSize="12" Padding="0" Margin="5,0,0,0"
                                        BackgroundColor="{StaticResource Gray300}" TextColor="{StaticResource Gray900}"
                                        Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.MoveDownCommand}" CommandParameter="{Binding .}"/>
                                <Button Grid.Column="4" Text="&#x270E;" WidthRequest="40" HeightRequest="40" FontSize="16" Padding="0" Margin="10,0,0,0"
                                        BackgroundColor="{StaticResource Primary}" TextColor="White"
                                        Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.EditArticleCommand}" CommandParameter="{Binding .}"/>
                                <Button Grid.Column="5" Text="&#x1F5D1;" WidthRequest="40" HeightRequest="40" FontSize="16" Padding="0" Margin="5,0,0,0"
                                        BackgroundColor="Red" TextColor="White"
                                        Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.DeleteArticleCommand}" CommandParameter="{Binding .}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Padding="40">
                        <Label Text="Keine Artikel vorhanden" FontSize="18" TextColor="Gray" HorizontalTextAlignment="Center"/>
                        <Label Text="Tippe auf &apos;+&apos; um einen neuen Artikel anzulegen" FontSize="14" TextColor="Gray" HorizontalTextAlignment="Center" Margin="0,10,0,0"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>

            <!-- Edit Panel - full-width overlay -->
            <Border BackgroundColor="White" StrokeThickness="0" IsVisible="{Binding IsEditing}">
                <ScrollView>
                    <VerticalStackLayout Spacing="15" Padding="16">

                        <Label Text="{Binding IsNewArticle, Converter={StaticResource NewEditTitleConverter}}" FontSize="20" FontAttributes="Bold"/>

                        <VerticalStackLayout>
                            <Label Text="Beschreibung *" FontSize="14" FontAttributes="Bold"/>
                            <Editor Text="{Binding EditDescription}" Placeholder="Artikelname eingeben" BackgroundColor="{StaticResource Gray100}" HeightRequest="80" AutoSize="TextChanges"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout>
                            <Label Text="Kategorie" FontSize="14" FontAttributes="Bold"/>
                            <Picker ItemsSource="{Binding Categories}" SelectedItem="{Binding EditCategory}"
                                    ItemDisplayBinding="{Binding Name}" BackgroundColor="{StaticResource Gray100}"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout>
                            <Label Text="Reihenfolge (SortOrder)" FontSize="14" FontAttributes="Bold"/>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                <Button Grid.Column="0" Text="&#x2212;" Command="{Binding DecreaseSortOrderCommand}"
                                        WidthRequest="44" HeightRequest="44" CornerRadius="8" Padding="0"
                                        FontSize="18" FontAttributes="Bold" BackgroundColor="{StaticResource Gray400}" TextColor="White"/>
                                <Entry Grid.Column="1" Text="{Binding EditSortOrder}" Keyboard="Numeric" HorizontalTextAlignment="Center" BackgroundColor="{StaticResource Gray100}"/>
                                <Button Grid.Column="2" Text="+" Command="{Binding IncreaseSortOrderCommand}"
                                        WidthRequest="44" HeightRequest="44" CornerRadius="8" Padding="0"
                                        FontSize="18" FontAttributes="Bold" BackgroundColor="{StaticResource Primary}" TextColor="White"/>
                            </Grid>
                            <Label Text="Niedrigere Zahl = weiter oben / links" FontSize="11" TextColor="Gray"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout>
                            <Label Text="Preis (&#x20AC;)" FontSize="14" FontAttributes="Bold"/>
                            <Entry Text="{Binding EditPriceText, Mode=TwoWay}"
                                   Keyboard="Numeric" Placeholder="0,00" BackgroundColor="{StaticResource Gray100}"/>
                            <Label Text="Negative Preise f&#xFC;r R&#xFC;ckgaben (z.B. Pfand)" FontSize="11" TextColor="Gray"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout>
                            <Label Text="Icon (Unicode / Emoji)" FontSize="14" FontAttributes="Bold"/>

                            <!-- Current icon preview + entry + clear -->
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="0,0,0,6">
                                <Border Grid.Column="0"
                                        BackgroundColor="{Binding EditColor}"
                                        StrokeShape="RoundRectangle 8" StrokeThickness="0"
                                        WidthRequest="44" HeightRequest="44"
                                        IsVisible="{Binding HasEditIcon}">
                                    <Label Text="{Binding EditIcon}" FontSize="24"
                                           HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                                </Border>
                                <Entry Grid.Column="1"
                                       Text="{Binding EditIcon, Mode=TwoWay}"
                                       Placeholder="Emoji hier eingeben oder unten w&#xE4;hlen"
                                       BackgroundColor="{StaticResource Gray100}"
                                       FontSize="18"/>
                                <Button Grid.Column="2"
                                        Text="&#x2715;"
                                        Command="{Binding ClearIconCommand}"
                                        IsVisible="{Binding HasEditIcon}"
                                        BackgroundColor="{StaticResource Gray400}"
                                        TextColor="White"
                                        WidthRequest="44" HeightRequest="44"
                                        CornerRadius="8" Padding="0"/>
                            </Grid>

                            <!-- Quick-pick emoji grid -->
                            <Label Text="Schnellauswahl:" FontSize="12" TextColor="Gray"/>
                            <FlexLayout BindableLayout.ItemsSource="{Binding Source={x:Static viewmodels:ArticleManagementViewModel.AvailableIcons}}"
                                        Wrap="Wrap" JustifyContent="Start">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border Margin="3" WidthRequest="40" HeightRequest="40"
                                                StrokeShape="RoundRectangle 8" StrokeThickness="0"
                                                BackgroundColor="{StaticResource Gray200}">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.SelectIconCommand}"
                                                    CommandParameter="{Binding .}"/>
                                            </Border.GestureRecognizers>
                                            <Label Text="{Binding .}" FontSize="22"
                                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </VerticalStackLayout>

                        <VerticalStackLayout>
                            <Label Text="Farbe" FontSize="14" FontAttributes="Bold"/>
                            <FlexLayout BindableLayout.ItemsSource="{Binding AvailableColors}" Wrap="Wrap" JustifyContent="Start">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border Margin="3" WidthRequest="40" HeightRequest="40" StrokeShape="RoundRectangle 8"
                                                Stroke="{Binding Source={x:Reference ThisPage}, Path=BindingContext.EditColor, Converter={StaticResource SelectedColorBorderConverter}, ConverterParameter={Binding .}}"
                                                StrokeThickness="3" BackgroundColor="{Binding .}">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.SelectColorCommand}" CommandParameter="{Binding .}"/>
                                            </Border.GestureRecognizers>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </VerticalStackLayout>

                        <VerticalStackLayout>
                            <Label Text="Vorschau" FontSize="14" FontAttributes="Bold"/>
                            <controls:TileControl
                                Title="{Binding EditDescription, TargetNullValue='Artikelname'}"
                                SubTitle="{Binding EditPrice, StringFormat='{0:F2} €'}"
                                Icon="{Binding EditIcon}"
                                TileColor="{Binding EditColor}"
                                TileWidthRequest="140"
                                TileHeightRequest="100"
                                HorizontalOptions="Start"/>
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Grid.Column="0" Text="Abbrechen" Command="{Binding CancelEditCommand}" BackgroundColor="{StaticResource Gray400}" TextColor="White"/>
                            <Button Grid.Column="1" Text="Speichern" Command="{Binding SaveArticleCommand}" BackgroundColor="{StaticResource Primary}" TextColor="White"/>
                        </Grid>

                    </VerticalStackLayout>
                </ScrollView>
            </Border>

        </Grid>

        <!-- Add Button -->
        <Button Grid.Row="1" Text="+ Neuen Artikel anlegen" Command="{Binding NewArticleCommand}"
                BackgroundColor="{StaticResource Primary}" TextColor="White" FontSize="16" Margin="10" HeightRequest="50"/>
    </Grid>
</ContentPage>
