<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:FestKasse.Helpers"
             x:Class="FestKasse.Views.AboutPage"
             Title="{helpers:Tr Key=About_Title}"
             BackgroundColor="{StaticResource Gray100}">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="20" VerticalOptions="Center">

            <Label Text="{helpers:Tr Key=About_AppTitle}" FontSize="32" FontAttributes="Bold" HorizontalTextAlignment="Center"
                   TextColor="{StaticResource Primary}"/>

            <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="20">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{helpers:Tr Key=About_Description}" FontSize="15" LineHeight="1.4"/>
                    <Label Text="{helpers:Tr Key=About_Features_Title}" FontSize="16" FontAttributes="Bold" Margin="0,8,0,0"/>
                    <Label Text="{helpers:Tr Key=About_Features}" FontSize="14" LineHeight="1.5"/>
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="20">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{helpers:Tr Key=About_Story}" FontSize="15" FontAttributes="Italic" LineHeight="1.4"/>

                    <Label TextColor="{StaticResource Primary}" FontSize="15" TextDecorations="Underline">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnWebsiteTapped"/>
                        </Label.GestureRecognizers>
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="🌐 www.weinfest-donnersdorf.de"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Label TextColor="{StaticResource Primary}" FontSize="15" TextDecorations="Underline">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnGitHubTapped"/>
                        </Label.GestureRecognizers>
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="🐙 github.com/matthiasNX/FestKasse"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </VerticalStackLayout>
            </Border>

            <Label Text="{helpers:Tr Key=About_Footer}" FontSize="12" TextColor="Gray" HorizontalTextAlignment="Center"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
