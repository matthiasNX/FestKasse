<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FestKasse.ViewModels"
             xmlns:models="clr-namespace:FestKasse.Models"
             xmlns:converters="clr-namespace:FestKasse.Converters"
             xmlns:helpers="clr-namespace:FestKasse.Helpers"
             x:Class="FestKasse.Views.OrderHistoryPage"
             x:Name="ThisPage"
             x:DataType="viewmodels:OrderHistoryViewModel"
             Title="{helpers:Tr Key=OrderHistory_Title}"
             BackgroundColor="{StaticResource Gray100}">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Filter bar -->
        <Border Grid.Row="0" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 0" Padding="12,8">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" RowDefinitions="Auto,Auto" RowSpacing="4">

                <!-- Row 0: labels -->
                <Label Grid.Row="0" Grid.Column="0" Text="{helpers:Tr Key=OrderHistory_FilterFrom}"
                       VerticalOptions="Center" FontSize="14"/>
                <Label Grid.Row="0" Grid.Column="2" Text="{helpers:Tr Key=OrderHistory_FilterTo}"
                       VerticalOptions="Center" FontSize="14" Margin="4,0,0,0"/>

                <!-- Row 1: date pickers -->
                <DatePicker Grid.Row="1" Grid.Column="0" Date="{Binding FilterFromDate}" Format="dd.MM.yyyy"
                            VerticalOptions="Center"/>
                <TimePicker Grid.Row="1" Grid.Column="1" Time="{Binding FilterFromTime}" Format="HH:mm"
                            VerticalOptions="Center"/>
                <DatePicker Grid.Row="1" Grid.Column="2" Date="{Binding FilterToDate}" Format="dd.MM.yyyy"
                            VerticalOptions="Center"/>
                <TimePicker Grid.Row="1" Grid.Column="3" Time="{Binding FilterToTime}" Format="HH:mm"
                            VerticalOptions="Center"/>
                <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="4"
                        Text="&#x1F504;" WidthRequest="44" HeightRequest="44" Padding="0"
                        Command="{Binding LoadOrdersCommand}"
                        BackgroundColor="{StaticResource Primary}" TextColor="White"
                        VerticalOptions="Center"/>
            </Grid>
        </Border>

        <!-- Summary bar -->
        <Border Grid.Row="1" BackgroundColor="{StaticResource Primary}" StrokeThickness="0" Padding="14,6"
                IsVisible="{Binding HasOrders}">
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="{Binding Orders.Count, StringFormat='&#x1F4CB; {0}'}"
                       TextColor="White" FontSize="13" VerticalOptions="Center"/>
                <HorizontalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                    <Label Text="{helpers:Tr Key=OrderHistory_Total}"
                           TextColor="White" FontSize="13" FontAttributes="Bold"/>
                    <Label Text="{Binding TotalSumDisplay}"
                           TextColor="White" FontSize="13" FontAttributes="Bold"/>
                </HorizontalStackLayout>
            </Grid>
        </Border>

        <!-- Orders list -->
        <ScrollView Grid.Row="2" Margin="10,6">
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Orders}" Spacing="3">
                <BindableLayout.EmptyView>
                    <Label Text="{helpers:Tr Key=OrderHistory_Empty}"
                           TextColor="{StaticResource Gray400}" HorizontalTextAlignment="Center"
                           FontSize="14" Margin="0,30,0,0"/>
                </BindableLayout.EmptyView>
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:OrderHistoryItem">
                        <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="0">
                            <VerticalStackLayout>

                                <!-- Order header -->
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" Padding="12,8" ColumnSpacing="8">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.ToggleExpandCommand}"
                                            CommandParameter="{Binding .}"/>
                                    </Grid.GestureRecognizers>
                                    <Label Grid.Column="0" Text="&#x1F4C5;" FontSize="16" VerticalOptions="Center"/>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                        <Label Text="{Binding TimestampDisplay}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Gray900}"/>
                                        <Label Text="{Binding StandName}" FontSize="11" TextColor="{StaticResource Gray500}"/>
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="{Binding TotalDisplay}" FontSize="16" FontAttributes="Bold"
                                           TextColor="{StaticResource Primary}" VerticalOptions="Center"/>
                                    <Button Grid.Column="3" Text="&#x1F5D1;" FontSize="16"
                                            WidthRequest="38" HeightRequest="38" Padding="0"
                                            BackgroundColor="Transparent" TextColor="#CC2200"
                                            Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.DeleteOrderCommand}"
                                            CommandParameter="{Binding .}"
                                            VerticalOptions="Center"/>
                                </Grid>

                                <!-- Order line items -->
                                <VerticalStackLayout IsVisible="{Binding IsExpanded}"
                                                     BackgroundColor="{StaticResource Gray100}"
                                                     Padding="6,3" Spacing="0"
                                                     BindableLayout.ItemsSource="{Binding Items}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:OrderItemRecord">
                                            <Grid ColumnDefinitions="Auto,*,Auto" Padding="8,3">
                                                <Label Grid.Column="0" Text="{Binding Quantity, StringFormat='{0}x'}"
                                                       FontSize="13" WidthRequest="30" TextColor="{StaticResource Gray700}" FontAttributes="Bold"/>
                                                <Label Grid.Column="1" Text="{Binding ArticleName}" FontSize="13" TextColor="{StaticResource Gray700}"/>
                                                <Label Grid.Column="2" Text="{Binding LineTotal, StringFormat='{0:F2} €'}"
                                                       FontSize="13" FontAttributes="Bold" HorizontalOptions="End" TextColor="{StaticResource Gray900}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Action buttons -->
        <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="6" Margin="10,6">
            <Button Text="{helpers:Tr Key=OrderHistory_Export_Json}"
                    Command="{Binding ExportToJsonCommand}"
                    IsVisible="{Binding HasOrders}"
                    BackgroundColor="{StaticResource Primary}" TextColor="White"
                    FontSize="14" HeightRequest="50"/>
            <Button Grid.Column="1" Text="{helpers:Tr Key=OrderHistory_Export_Db}"
                    Command="{Binding ExportDbFileCommand}"
                    IsVisible="{Binding HasOrders}"
                    BackgroundColor="#5B4FCF" TextColor="White"
                    FontSize="14" HeightRequest="50"/>
        </Grid>
    </Grid>

</ContentPage>
