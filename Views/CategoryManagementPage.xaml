<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FestKasse.ViewModels"
             xmlns:models="clr-namespace:FestKasse.Models"
             xmlns:helpers="clr-namespace:FestKasse.Helpers"
             xmlns:controls="clr-namespace:FestKasse.Controls"
             x:Class="FestKasse.Views.CategoryManagementPage"
             x:Name="ThisPage"
             Title="{helpers:Tr Key=Category_Title}"
             BackgroundColor="{StaticResource Gray100}">

    <Grid RowDefinitions="*,Auto">

        <Grid Grid.Row="0">

            <!-- Category List -->
            <CollectionView ItemsSource="{Binding Categories}" SelectionMode="None" Margin="10">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Category">
                        <Border Margin="0,5" Padding="10" BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource DarkGray200}}" StrokeShape="RoundRectangle 8" StrokeThickness="0">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                    <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold"/>
                                    <HorizontalStackLayout Spacing="4">
                                        <Label Text="{helpers:Tr Key=Category_SortOrder_Label}" FontSize="12" TextColor="Gray"/>
                                        <Label Text="{Binding SortOrder}" FontSize="12" TextColor="Gray"/>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                                <Button Grid.Column="1" Text="&#x25B2;" WidthRequest="40" HeightRequest="40" FontSize="12" Padding="0"
                                        BackgroundColor="{StaticResource Gray300}" TextColor="{StaticResource Gray900}"
                                        Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.MoveUpCommand}" CommandParameter="{Binding .}"/>
                                <Button Grid.Column="2" Text="&#x25BC;" WidthRequest="40" HeightRequest="40" FontSize="12" Padding="0" Margin="5,0,0,0"
                                        BackgroundColor="{StaticResource Gray300}" TextColor="{StaticResource Gray900}"
                                        Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.MoveDownCommand}" CommandParameter="{Binding .}"/>
                                <Button Grid.Column="3" Text="&#x270E;" WidthRequest="40" HeightRequest="40" FontSize="16" Padding="0" Margin="10,0,0,0"
                                        BackgroundColor="{StaticResource Primary}" TextColor="White"
                                        Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.EditCategoryCommand}" CommandParameter="{Binding .}"/>
                                <Button Grid.Column="4" Text="&#x1F5D1;" WidthRequest="40" HeightRequest="40" FontSize="16" Padding="0" Margin="5,0,0,0"
                                        BackgroundColor="Red" TextColor="White"
                                        Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.DeleteCategoryCommand}" CommandParameter="{Binding .}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Padding="40">
                        <Label Text="{helpers:Tr Key=Category_Empty}" FontSize="18" TextColor="Gray" HorizontalTextAlignment="Center"/>
                        <Label Text="{helpers:Tr Key=Category_EmptyHint}" FontSize="14" TextColor="Gray" HorizontalTextAlignment="Center" Margin="0,10,0,0"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>

            <!-- Edit Overlay -->
            <Border BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource DarkGray200}}" StrokeThickness="0" IsVisible="{Binding IsEditing}">
                <ScrollView>
                    <VerticalStackLayout Spacing="15" Padding="16">

                        <Label Text="{Binding IsNewCategory, Converter={StaticResource NewEditTitleConverter}, ConverterParameter=category}"
                               FontSize="20" FontAttributes="Bold"/>

                        <VerticalStackLayout>
                            <Label Text="{helpers:Tr Key=Category_Field_Name}" FontSize="14" FontAttributes="Bold"/>
                            <Entry Text="{Binding EditName}" Placeholder="{helpers:Tr Key=Category_Field_Name_Placeholder}" BackgroundColor="{StaticResource Gray100}"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout>
                            <Label Text="{helpers:Tr Key=Category_Field_SortOrder}" FontSize="14" FontAttributes="Bold"/>
                            <controls:SortOrderStepperControl
                                Value="{Binding EditSortOrder, Mode=TwoWay}"
                                IncreaseCommand="{Binding IncreaseSortOrderCommand}"
                                DecreaseCommand="{Binding DecreaseSortOrderCommand}"/>
                            <Label Text="{helpers:Tr Key=Category_Field_SortOrder_Hint}" FontSize="11" TextColor="Gray"/>
                        </VerticalStackLayout>

                        <controls:SaveCancelButtonRow
                            SaveText="{helpers:Tr Key=Category_Save_Button}"
                            CancelText="{helpers:Tr Key=Category_Cancel_Button}"
                            SaveCommand="{Binding SaveCategoryCommand}"
                            CancelCommand="{Binding CancelEditCommand}"/>

                    </VerticalStackLayout>
                </ScrollView>
            </Border>

        </Grid>

        <!-- Add Button -->
        <Button Grid.Row="1" Text="{helpers:Tr Key=Category_Add_Button}" Command="{Binding NewCategoryCommand}"
                BackgroundColor="{StaticResource Primary}" TextColor="White" FontSize="16" Margin="10" HeightRequest="50"/>
    </Grid>

    <ContentPage.Resources>
        <converters:NewEditTitleConverter xmlns:converters="clr-namespace:FestKasse.Converters" x:Key="NewEditTitleConverter"/>
    </ContentPage.Resources>

</ContentPage>
